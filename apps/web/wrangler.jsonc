// The site is a few prerendered pages, served as static assets at mrow.wania.app.
// Deploy: .github/workflows/deploy-web.yml on changes to main and after each release, or by hand:
// pnpm --filter @mrow/web run deploy (builds, then wrangler deploy).
{
  "$schema": "https://unpkg.com/wrangler@4.162.0/config-schema.json",
  "name": "mrow",
  // The deploy workflow authenticates with the CLOUDFLARE_API_TOKEN secret.
  "account_id": "808d60812de3e8dff90020f6a37634c5",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "mrow.wania.app", "custom_domain": true }],
  "workers_dev": false
}
