// The site is one prerendered page, served as static assets at mrow.wania.app.
// Deploy: pnpm --filter @mrow/web deploy (builds, then wrangler deploy).
{
  "$schema": "https://unpkg.com/wrangler@4.162.0/config-schema.json",
  "name": "mrow",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "mrow.wania.app", "custom_domain": true }],
  "workers_dev": false
}
